# Copy this file to `.env` and fill in what you use.
# Keys are read from the environment first, then from `.env`.
# Leave a key empty to skip that provider — Jarvis falls back
# to the next provider in config.yaml, then to local Ollama,
# then to fully offline mode (local tools still work).

# Google Gemini (free tier key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# OpenAI-compatible API (OpenAI, Groq, DeepSeek, OpenRouter, ...)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Local Ollama (no key needed; default http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434
